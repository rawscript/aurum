# ---- Server ----
PORT=3000
BASE_URL=https://your-domain.example.com   # public URL Aurum is deployed at (used to build wa.me links)

# ---- WhatsApp Cloud API (Meta) ----
# Create an app at developers.facebook.com, add the WhatsApp product,
# and grab these from the WhatsApp > API Setup page.
WHATSAPP_TOKEN=                # permanent or temporary access token
WHATSAPP_PHONE_NUMBER_ID=      # the "Phone number ID", not the phone number itself
WHATSAPP_VERIFY_TOKEN=aurum-verify-me   # any string you choose; used in webhook handshake
WHATSAPP_BUSINESS_NUMBER=      # the actual WhatsApp number in international format, e.g. 15551234567 (used for wa.me links)

# ---- Google Sheets export ----
# Create a service account in Google Cloud Console, enable the Sheets API,
# download the JSON key, and either point to the file or paste the values below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=        # keep the \n escape sequences as-is
GOOGLE_SHEETS_SPREADSHEET_ID=              # optional default sheet; Aurum can also create one per form

# ---- Misc ----
NUDGE_AFTER_MINUTES=60         # how long to wait before nudging an abandoned chat
REMINDER_HOURS_BEFORE_EVENT=24 # how long before an event to send the reminder